{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quadrant",
  "version": "26.7.8-stable",
  "identifier": "dev.mrquantumoff.mcmodpackmanager",
  "build": {
    "beforeDevCommand": "bun dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "features": ["proprietary", "updater"]
  },
  "app": {
    "windows": [
      {
        "title": "Quadrant",
        "width": 1280,
        "height": 720,
        "minHeight": 500,
        "minWidth": 800,
        "resizable": true,
        "devtools": true,
        "decorations": false,
        "browserExtensionsEnabled": false,
        "shadow": true,
        "theme": "Dark",
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 https: wss:; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    },
    "trayIcon": {
      "iconPath": "../public/tray.png",
      "title": "Quadrant"
    },
    "enableGTKAppId": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["quadrantnext", "curseforge", "modrinth"]
      }
    },
    "cli": {
      "description": "Hide the window on start",
      "args": [
        {
          "name": "autostart",
          "description": "Whether the app should start hidden"
        },
        {
          "name": "noupdater",
          "description": "Prevent the app from automatically updating (aimed at flatpak builds)"
        },
        {
          "name": "api-url",
          "description": "Override the Quadrant API base URL"
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3MEJDMDAxMjA4NjlBQ0MKUldUTW1vWWdBY0FMcCtkS3FwaTlKSzBaMHpXaW4ramRLS1ludmVyUEZpSUY3Mmc0cm1zeGUvRGIK",
      "endpoints": [
        "https://api.usequadrant.dev/api/any/quadrant/updates/stable/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "rpm", "dmg", "app"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "openssl",
          "curl",
          "wget",
          "libappindicator3-1",
          "librsvg2-2",
          "libsecret-1-0"
        ],
        "desktopTemplate": "../Quadrant.desktop"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "openssl",
          "curl",
          "wget",
          "libappindicator",
          "librsvg2",
          "libsecret"
        ],
        "desktopTemplate": "../Quadrant.desktop"
      }
    },
    "icon": [
      "icons/logo.svg",
      "icons/quadrant_next.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "licenseFile": "../LICENSE.rtf",
    "shortDescription": "Manage your mods and modpacks with ease.",
    "longDescription": "This is a powerful tool to manage your Minecraft: Java Edition mods. With this app you can easily install mods, resourcepacks, shaders. You can also share you modpacks with your friends, and you can back up your modpacks to the cloud!",
    "fileAssociations": [
      {
        "ext": ["modpackconfig.json", "modpackConfig", "quadrantModpack.json"],
        "description": "Quadrant Modpack Config File"
      }
    ],
    "resources": ["../public"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "allowDowngrades": true,
      "nsis": {
        "languages": ["Ukrainian", "English", "Turkish"]
      }
    },
    "publisher": "MrQuantumOFF (Demir Yerli)",
    "copyright": "Copyright © 2026 MrQuantumOFF (Demir Yerli)",
    "homepage": "https://usequadrant.dev",
    "license": "MPL-2.0",
    "createUpdaterArtifacts": true
  }
}
