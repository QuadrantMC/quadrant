    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "dev:electron": "bun scripts/dev-electron.ts",
    "build:electron": "bun scripts/build-electron.ts",
    "package:electron": "bun scripts/package-electron.ts",
    "tauri": "tauri",
    "tauri:windows:build": "tauri-windows-bundle build"
  },
  "dependencies": {
    "@quadrant/quadrant-node": "workspace:*",
    "@fabianlars/tauri-plugin-oauth": "^2.0.0",
