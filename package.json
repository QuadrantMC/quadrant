{
  "name": "quadrant-next",
  "private": true,
  "version": "26.6.2-stable",
  "type": "module",
  "description": "An easy way to manage your Minecraft mods and modpacks.",
  "author": "Demir Yerli <me@mrquantumoff.dev>",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
