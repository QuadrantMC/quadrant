    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.3",
    "i18next": "26.3.0",
    "motion": "12.40.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "17.0.8",
    "react-icons": "^5.6.0"
